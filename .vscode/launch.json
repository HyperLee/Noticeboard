{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch NoticeBoard",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/NoticeBoard/bin/Debug/net10.0/NoticeBoard.dll",
      "args": [],
      "cwd": "${workspaceFolder}/NoticeBoard",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5000"
      }
    }
  ]
}
