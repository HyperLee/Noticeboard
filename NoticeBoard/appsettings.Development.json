{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.SignalR": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.AspNetCore.SignalR": "Debug",
        "System": "Information"
      }
    }
  },
  "Storage": {
    "DataDirectory": "Data",
    "MessagesFile": "messages.json",
    "LikesFile": "likes.json"
  },
  "Cleanup": {
    "Enabled": false,
    "RetentionHours": 24,
    "IntervalMinutes": 5
  },
  "Admin": {
    "Username": "admin",
    "Password": "admin999",
    "SessionTimeoutMinutes": 60
  },
  "ContentModeration": {
    "MaxContentLength": 300,
    "MinContentLength": 1,
    "MaxNicknameLength": 20,
    "BlacklistedWords": ["spam", "test-blocked"]
  },
  "RateLimiting": {
    "Enabled": false,
    "RequestsPerMinute": 60,
    "BurstLimit": 20
  }
}
